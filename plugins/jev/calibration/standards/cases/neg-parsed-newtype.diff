diff --git a/src/port.rs b/src/port.rs
--- a/src/port.rs
+++ b/src/port.rs
@@ -0,0 +1,18 @@
+pub struct Port(NonZeroU16);
+
+#[derive(Debug, thiserror::Error)]
+pub enum PortError {
+    #[error("not a number: {0}")]
+    NotANumber(#[from] ParseIntError),
+    #[error("port 0 is reserved")]
+    Zero,
+}
+
+impl FromStr for Port {
+    type Err = PortError;
+
+    fn from_str(s: &str) -> Result<Self, PortError> {
+        let n: u16 = s.parse()?;
+        NonZeroU16::new(n).map(Port).ok_or(PortError::Zero)
+    }
+}

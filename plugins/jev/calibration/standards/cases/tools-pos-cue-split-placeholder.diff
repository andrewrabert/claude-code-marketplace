--- a/src/cue.rs
+++ b/src/cue.rs
@@ -0,0 +49,96 @@
+pub struct CueSheet {
+    #[expect(dead_code, reason = "read once archive extract moves onto CueSheet")]
+    files: Vec<File>,
+    tracks: Vec<Track>,
+}
+
+impl CueSheet {
+    /// Fails if the sheet's bytes differ from [`to_utf8`] of them, the sheet has no tracks, a line
+    /// starts with something other than a command, or a `FILE` or `TRACK` line breaks its syntax.
+    pub fn new(data: &[u8]) -> Result<Self, CueSheetError> {
+        let text = to_utf8(data);
+        if text.as_bytes() != data {
+            return Err(CueSheetError::Encoding);
+        }
+        let mut files = Vec::new();
+        let mut tracks = Vec::new();
+        for line in text.lines() {
+            let line = line.trim();
+            if line.is_empty() {
+                continue;
+            }
+            let (command, arguments) = line.split_once(char::is_whitespace).unwrap_or((line, ""));
+            let arguments = arguments.trim_start();
+            match Command::try_from(command)? {
+                Command::File => {
+                    let (filename, filetype) =
+                        file_arguments(arguments).ok_or(CueSheetError::InvalidFileLine)?;
+                    files.push(File {
+                        filename: filename.to_owned(),
+                        filetype: Filetype::from(filetype),
+                    });
+                }
+                Command::Track => {
+                    let mut tokens = arguments.split_whitespace();
+                    let (Some(number), Some(datatype), None) =
+                        (tokens.next(), tokens.next(), tokens.next())
+                    else {
+                        return Err(CueSheetError::InvalidTrackLine);
+                    };
+                    tracks.push(Track {
+                        number: number.to_owned(),
+                        datatype: Datatype::from(datatype),
+                    });
+                }
+                Command::Catalog
+                | Command::Cdtextfile
+                | Command::Flags
+                | Command::Index
+                | Command::Isrc
+                | Command::Performer
+                | Command::Postgap
+                | Command::Pregap
+                | Command::Rem
+                | Command::Songwriter
+                | Command::Title => {}
+            }
+        }
+        if tracks.is_empty() {
+            return Err(CueSheetError::NoTracks);
+        }
+        Ok(Self { files, tracks })
+    }
+
+    pub fn track_count(&self) -> usize {
+        self.tracks.len()
+    }
+
+    #[expect(dead_code, reason = "read once archive extract moves onto CueSheet")]
+    pub fn files(&self) -> &[File] {
+        &self.files
+    }
+
+    #[expect(dead_code, reason = "read once archive extract moves onto CueSheet")]
+    pub fn tracks(&self) -> &[Track] {
+        &self.tracks
+    }
+}
+
+/// Splits `[filename] [filetype]`. A filename with spaces is enclosed in quotation marks.
+fn file_arguments(arguments: &str) -> Option<(&str, &str)> {
+    let (filename, rest) = match arguments.strip_prefix('"') {
+        Some(quoted) => {
+            let (filename, rest) = quoted.split_once('"')?;
+            if !rest.starts_with(char::is_whitespace) {
+                return None;
+            }
+            (filename, rest)
+        }
+        None => arguments.split_once(char::is_whitespace)?,
+    };
+    let mut tokens = rest.split_whitespace();
+    match (tokens.next(), tokens.next()) {
+        (Some(filetype), None) => Some((filename, filetype)),
+        _ => None,
+    }
+}

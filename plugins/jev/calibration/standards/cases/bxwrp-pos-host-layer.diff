diff --git a/src/config.rs b/src/config.rs
--- a/src/config.rs
+++ b/src/config.rs
@@ -0,0 +900,6 @@
+    /// Loads one more config file over the ones already loaded, as a last `--config` would.
+    pub fn layer(mut self, path: PathBuf) -> anyhow::Result<Self> {
+        self.config = self.config.merge(Config::load(&path)?);
+        self.paths.push(path);
+        Ok(self)
+    }

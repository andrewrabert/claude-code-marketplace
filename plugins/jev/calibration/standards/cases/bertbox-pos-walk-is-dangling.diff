diff --git a/src/walk.rs b/src/walk.rs
--- a/src/walk.rs
+++ b/src/walk.rs
@@ -0,0 +1,24 @@
+use std::fs;
+use std::path::Path;
+
+use anyhow::Result;
+use walkdir::{DirEntry, WalkDir};
+
+/// Every entry under `root`, `root` included, descending through symlinked directories.
+/// A symlink that cannot be resolved is neither a file nor a directory, so it is skipped.
+pub fn entries(root: &Path) -> impl Iterator<Item = Result<DirEntry>> {
+    WalkDir::new(root)
+        .follow_links(true)
+        .into_iter()
+        .filter_map(|entry| match entry {
+            Ok(entry) => Some(Ok(entry)),
+            Err(error) if is_dangling(&error) => None,
+            Err(error) => Some(Err(error.into())),
+        })
+}
+
+fn is_dangling(error: &walkdir::Error) -> bool {
+    error
+        .path()
+        .is_some_and(|path| path.is_symlink() && fs::metadata(path).is_err())
+}

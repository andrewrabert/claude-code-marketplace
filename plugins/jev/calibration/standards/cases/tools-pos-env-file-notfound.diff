diff --git a/src/env_file.rs b/src/env_file.rs
--- a/src/env_file.rs
+++ b/src/env_file.rs
@@ -0,0 +47,30 @@
+/// The `--env-file` paths, in command-line order, from a pre-pass that ignores
+/// parse errors; the real parse reports them. Clap hands a global flag's
+/// values to the tool's matches, so the paths are read there.
+fn env_files(command: &Command) -> Vec<PathBuf> {
+    let Ok(mut matches) = command.clone().ignore_errors(true).try_get_matches() else {
+        return Vec::new();
+    };
+    while let Some((_, tool)) = matches.remove_subcommand() {
+        matches = tool;
+    }
+    matches
+        .try_remove_many::<PathBuf>(ID)
+        .ok()
+        .flatten()
+        .map(|paths| paths.collect())
+        .unwrap_or_default()
+}
+
+/// The variables the file binds. An absent file binds nothing; an unreadable
+/// or malformed one is an error naming it.
+fn read(path: &Path) -> Result<BTreeMap<String, String>> {
+    let text = match std::fs::read_to_string(path) {
+        Ok(text) => text,
+        Err(e) if e.kind() == ErrorKind::NotFound => return Ok(BTreeMap::new()),
+        Err(e) => return Err(e).with_context(|| format!("reading {}", path.display())),
+    };
+    dotenvy::from_read_iter(text.as_bytes())
+        .collect::<Result<_, _>>()
+        .with_context(|| format!("parsing {}", path.display()))
+}

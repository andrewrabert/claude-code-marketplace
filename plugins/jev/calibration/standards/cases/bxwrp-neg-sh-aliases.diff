diff --git a/src/main.rs b/src/main.rs
--- a/src/main.rs
+++ b/src/main.rs
@@ -0,0 +12,20 @@
+const SH: &str = "sh";
+
+const BASH: &str = "bash";
+
+const SH_ALIASES: [(&str, &str); 4] = [
+    ("bxwrp-sh", SH),
+    (SH, SH),
+    ("bxwrp-bash", BASH),
+    (BASH, BASH),
+];
+
+fn main() -> anyhow::Result<()> {
+    let mut argv = std::env::args_os();
+    let argv0 = argv.next().map(std::path::PathBuf::from);
+    let shell = argv0.and_then(|path| {
+        let name = path.file_name()?;
+        SH_ALIASES
+            .into_iter()
+            .find_map(|(alias, shell)| (name == alias).then_some(shell))
+    });

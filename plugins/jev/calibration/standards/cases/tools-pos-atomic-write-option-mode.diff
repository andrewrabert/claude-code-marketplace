--- a/src/atomic_write.rs
+++ b/src/atomic_write.rs
@@ -0,0 +1,30 @@
+//! Files written to a temporary sibling, then moved over their destination.
+use std::ffi::OsStr;
+use std::fs::Permissions;
+use std::os::unix::fs::PermissionsExt;
+use std::path::Path;
+
+use anyhow::{Context, Result};
+use tempfile::{Builder, TempPath};
+
+const DEFAULT_MODE: u32 = 0o666;
+
+/// A temporary file in `dir` named after `path` plus `.tmp`.
+pub fn sibling(dir: &Path, prefix: &str, path: &Path, mode: Option<u32>) -> Result<TempPath> {
+    let mut suffix = path.file_name().map(OsStr::to_owned).unwrap_or_default();
+    suffix.push(".tmp");
+    let file = Builder::new()
+        .prefix(prefix)
+        .suffix(&suffix)
+        .permissions(Permissions::from_mode(mode.unwrap_or(DEFAULT_MODE)))
+        .tempfile_in(dir)
+        .with_context(|| format!("creating a temporary file in {}", dir.display()))?;
+    Ok(file.into_temp_path())
+}
+
+/// Moves the temporary file over `dest`.
+pub fn replace(temp: TempPath, dest: &Path) -> Result<()> {
+    temp.persist(dest)
+        .with_context(|| format!("writing {}", dest.display()))?;
+    Ok(())
+}
